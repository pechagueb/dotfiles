# Config generated by Ghostty Config
# https://ghostty.zerebos.com

background-blur = macos-glass-regular
background-opacity = 0.60
clipboard-read = allow
theme = Blazer

window-padding-balance = true
window-padding-x = 10
window-padding-y = 10

keybind = shift+ctrl+c=copy_to_clipboard
keybind = shift+ctrl+v=paste_from_clipboard
